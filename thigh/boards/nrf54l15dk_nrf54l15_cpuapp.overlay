/*
 * Wiring of the thigh patch on an nRF54L15 DK. PIN NUMBERS ARE PLACEHOLDERS:
 * on your own PCB, re-check them against the nRF54L15 pin table (SPI SCK /
 * TWIM SCL must sit on the port's dedicated clock pins).
 *
 *  AD5941 (histamine)  SCK P1.03  MOSI P1.08  MISO P1.09  CS P1.10   (spi21, 8 MHz, mode 0)
 *                      RESET P0.01; sensor on CE0 / RE0 / SE0 (3-electrode cell)
 *  I2C                 SCL P1.04  SDA P1.05 (4.7k pull-ups)  (i2c22, 400 kHz)
 *    LSM6DSO thigh     0x6A (SA0 low), INT1 P0.05
 *  Release motor       MOSFET gate P1.15 (add a 100k gate pull-down)
 *  Vibration motor     P1.14 (through its own transistor)
 *  Status LED          DK LED0 (P2.09)
 *  Service button      DK BUTTON3 (P0.04)
 *  Radio               Bluetooth LE link to the chest patch
 */

/ {
	zephyr,user {
		motor-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
		/* endstop-gpios = <&gpio0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; */
		alert-gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
		status-led-gpios = <&gpio2 9 GPIO_ACTIVE_HIGH>;
		service-gpios = <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};

&pinctrl {
	spi21_default_alt: spi21_default_alt {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 3)>,
				<NRF_PSEL(SPIM_MOSI, 1, 8)>,
				<NRF_PSEL(SPIM_MISO, 1, 9)>;
		};
	};

	spi21_sleep_alt: spi21_sleep_alt {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 3)>,
				<NRF_PSEL(SPIM_MOSI, 1, 8)>,
				<NRF_PSEL(SPIM_MISO, 1, 9)>;
			low-power-enable;
		};
	};

	i2c22_default_alt: i2c22_default_alt {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 4)>,
				<NRF_PSEL(TWIM_SDA, 1, 5)>;
		};
	};

	i2c22_sleep_alt: i2c22_sleep_alt {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 4)>,
				<NRF_PSEL(TWIM_SDA, 1, 5)>;
			low-power-enable;
		};
	};
};

/* DK peripherals sitting on pins we use */
&uart20 {
	status = "disabled";
};

&uart30 {
	status = "disabled";
};

&spi21 {
	status = "okay";
	pinctrl-0 = <&spi21_default_alt>;
	pinctrl-1 = <&spi21_sleep_alt>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;

	ad5941: ad5941@0 {
		compatible = "wearable,ad5941";
		reg = <0>;
		spi-max-frequency = <8000000>;
		reset-gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
	};
};

&i2c22 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c22_default_alt>;
	pinctrl-1 = <&i2c22_sleep_alt>;
	pinctrl-names = "default", "sleep";

	imu_thigh: lsm6dso@6a {
		compatible = "wearable,lsm6dso";
		reg = <0x6a>;
		int1-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
	};
};

&gpiote20 {
	status = "okay";
};

&gpiote30 {
	status = "okay";
};

&wdt31 {
	status = "okay";
};
