/*
 * The FLPR coprocessor owns the ADS1292R: SPI21, DRDY on port 1 (GPIOTE20)
 * and the PWDN/START outputs. Pins are the same placeholders as the
 * application core's overlay (../../boards/nrf54l15dk_nrf54l15_cpuapp.overlay).
 *
 *  ADS1292R  SCK P1.03  MOSI P1.08  MISO P1.09  CS P1.10   (spi21, 500 kHz)
 *            DRDY P1.07  PWDN/RESET P0.01  START P0.02
 */

/ {
	soc {
		reserved-memory {
			#address-cells = <1>;
			#size-cells = <1>;

			sram_tx: memory@20018000 {
				reg = <0x20018000 0x0800>;
			};

			sram_rx: memory@20020000 {
				reg = <0x20020000 0x0800>;
			};
		};
	};

	ipc {
		ipc0: ipc0 {
			compatible = "zephyr,ipc-icmsg";
			dcache-alignment = <32>;
			tx-region = <&sram_tx>;
			rx-region = <&sram_rx>;
			mboxes = <&cpuflpr_vevif_rx 21>, <&cpuflpr_vevif_tx 20>;
			mbox-names = "rx", "tx";
			status = "okay";
		};
	};
};

&cpuflpr_vevif_rx {
	status = "okay";
};

&cpuflpr_vevif_tx {
	status = "okay";
};

&pinctrl {
	spi21_default_alt: spi21_default_alt {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 3)>,
				<NRF_PSEL(SPIM_MOSI, 1, 8)>,
				<NRF_PSEL(SPIM_MISO, 1, 9)>;
		};
	};

	spi21_sleep_alt: spi21_sleep_alt {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 3)>,
				<NRF_PSEL(SPIM_MOSI, 1, 8)>,
				<NRF_PSEL(SPIM_MISO, 1, 9)>;
			low-power-enable;
		};
	};
};

/* its pins carry ADS1292R control lines; GPIOTE30 (port 0) belongs to the app core */
&uart30 {
	status = "disabled";
};

&gpiote30 {
	status = "disabled";
};

/* PWDN/START are plain outputs on port 0; its interrupts belong to the app core */
&gpio0 {
	/delete-property/ gpiote-instance;
};

&spi21 {
	status = "okay";
	pinctrl-0 = <&spi21_default_alt>;
	pinctrl-1 = <&spi21_sleep_alt>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;

	ads1292r: ads1292r@0 {
		compatible = "wearable,ads1292r";
		reg = <0>;
		spi-max-frequency = <500000>;
		drdy-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
		pwdn-gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
		start-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
	};
};
